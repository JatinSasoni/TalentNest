# Copy to .env and fill in values

PORT=8000
MONGODB_URI=
SECRET_KEY=
FRONTEND_URL=http://localhost:5173

# AI — Groq (recommended) or any OpenAI-compatible API
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Cloudinary
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email & company
COMPANY_NAME=TalentNest Pro
COMPANY_EMAIL=

# Razorpay
RAZOR_PAY_KEY=
RAZOR_PAY_SECRET=
RAZOR_PLAN_ID=

# Redis (Upstash) — cache + email queue
REDIS_URL=
EMAIL_QUEUE_NAME=emailQueue

# SMTP (worker)
BREVO_USER=
BREVO_PASS=
SELF_EMAIL=
SELF_PASSS=
